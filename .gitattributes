# Normalise line endings so a Windows checkout can't flip the whole tree to
# CRLF and drown real code changes in phantom diffs (this happened once and
# turned a 22-file change into 171 "modified" files).
#
# Everything git treats as text is stored LF in the repository. CI builds on
# Linux, so LF is also what the toolchain expects.
* text=auto eol=lf

# Binary — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.jar   binary
*.keystore binary
*.jks   binary
*.zip   binary
*.apk   binary
*.aab   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary

# Windows-only scripts must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
